@@ -76,11 +76,42 @@ impl TracePoint {
     ///
     /// The returned value can be used to detach, see [`TracePoint::detach`].
     pub fn attach(&mut self, category: &str, name: &str) -> Result<TracePointLinkId, ProgramError> {
+        self.attach_to_pid(category, name, None)
+    }
+
+    /// Attaches to a tracepoint for all tasks on one CPU.
+    pub fn attach_to_cpu(
+        &mut self,
+        category: &str,
+        name: &str,
+        cpu: u32,
+    ) -> Result<TracePointLinkId, ProgramError> {
+        let prog_fd = self.fd()?.as_fd();
+        let tracefs = find_tracefs_path()?;
+        let id = read_sys_fs_trace_point_id(tracefs, category, name.as_ref())?;
+        let perf_fd =
+            perf_event_open_trace_point_on_cpu(id, cpu).map_err(|io_error| SyscallError {
+                call: "perf_event_open_trace_point",
+                io_error,
+            })?;
+        // Preserve perf_event's CPU scope. BPF perf links on this kernel make
+        // each tracepoint attachment effectively global, causing N program
+        // copies to emit every event N times.
+        let link = attach_perf_event(prog_fd, perf_fd, None).map(PerfLinkInner::PerfLink)?;
+        self.data.links.insert(TracePointLink::new(link))
+    }
+
+    fn attach_to_pid(
